rules_version = '2';

// Firestore (database) security rules for cdg-ops-app.
// Starting point: everything is locked. Each feature opens only the access it needs.
// Server code (Cloud Functions) is not limited by these rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
