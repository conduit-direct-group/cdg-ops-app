rules_version = '2';

// Firestore (database) security rules for cdg-ops-app.
// Default: everything is locked. Each feature opens only the access it needs.
//
// Phones and tablets can only READ. Every change goes through the server code (Cloud Functions), which
// checks the person's live role first and writes the audit log — so the database rejects any direct
// change from anyone, admin or not.
//
// Roles are checked against the LIVE employee record on every read (not the sign-in pass), so turning
// someone off or removing their Admin role takes effect immediately.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with employee # + PIN, and already picked their own PIN (not on a temporary one).
    function signedIn() {
      return request.auth != null && request.auth.token.get('pinTemp', false) != true;
    }

    function employee() {
      return get(/databases/$(database)/documents/employees/$(request.auth.token.emp)).data;
    }

    // Signed in and the account is on right now.
    function member() {
      return signedIn() && employee().active != false;
    }

    // Has the Admin role right now.
    function admin() {
      return member() && employee().roles.hasAny(['admin']);
    }

    // Maintenance or Admin right now — they work the open-issues board. The Production Manager sees it too.
    function fixer() {
      return member() && employee().roles.hasAny(['maintenance', 'admin', 'plant-manager']);
    }

    // Supervisor, Training & Safety, Production Manager, Admin: see every open urgent request (safety concerns),
    // not only the ones sent to them — for their dashboard's safety card.
    function safetyWatcher() {
      return member() && employee().roles.hasAny(['supervisor', 'training-safety', 'plant-manager', 'admin']);
    }

    function me() {
      return request.auth.token.emp;
    }

    // HR access (a per-person switch, not a role): injury report details, write-ups, reviews.
    function hrAccess() {
      return member() && employee().get('hrAccess', false) == true;
    }

    // Your own employee record (name, roles, on/off) — so the app shows the right buttons the moment an
    // admin changes your roles. Never anyone else's, and never PIN records.
    match /employees/{employeeNumber} {
      allow read: if signedIn() && request.auth.token.emp == employeeNumber;
    }

    // Lines, machines, roles, checklists: everyone signed in can read (shop map, checklists, Fix Library).
    // Only the server changes them (admin screens).
    match /lines/{id} {
      allow read: if member();
    }
    match /machines/{id} {
      allow read: if member();
    }
    match /roles/{id} {
      allow read: if member();
    }
    match /checklistTemplates/{id} {
      allow read: if member();
    }
    // Teams (A, B, C, D), shifts, and machine types: read by everyone signed in; changed only by admins via the server.
    match /teams/{id} {
      allow read: if member();
    }
    match /shifts/{id} {
      allow read: if member();
    }
    match /machineTypes/{id} {
      allow read: if member();
    }

    // Shop map (company content: layout, stations, SOP text) — signed-in people only; admins change it via the server.
    match /floorMap/{id} {
      allow read: if member();
    }
    match /floorStations/{id} {
      allow read: if member();
    }
    match /sops/{id} {
      allow read: if member();
    }

    // Training (the trainer app): reference data, trainer profiles, trainee records, signatures, coordinator
    // to-dos, and changes waiting for the workbook — signed-in people only; every change goes through the server.
    // Trainer PINs (trainingPins) and unlock sessions (trainingSessions) stay locked (rule at the bottom).
    match /trainingRef/{id} {
      allow read: if member();
    }
    match /trainingTrainers/{id} {
      allow read: if member();
    }
    match /test_trainingTrainers/{id} {
      allow read: if member();
    }
    match /trainingPeople/{id} {
      allow read: if member();
    }
    match /test_trainingPeople/{id} {
      allow read: if member();
    }
    match /trainingSigs/{id} {
      allow read: if member();
    }
    match /test_trainingSigs/{id} {
      allow read: if member();
    }
    match /trainingShared/{id} {
      allow read: if member();
    }
    match /test_trainingShared/{id} {
      allow read: if member();
    }
    match /trainingWbQueue/{id} {
      allow read: if member();
    }

    // Checklist due dates (latest sign-off per item). The test site uses test_checklistUnits.
    match /checklistUnits/{id} {
      allow read: if member();
    }
    match /test_checklistUnits/{id} {
      allow read: if member();
    }

    // Every sign-off ever (history) — admins only.
    match /checklistSignoffs/{id} {
      allow read: if admin();
    }
    match /test_checklistSignoffs/{id} {
      allow read: if admin();
    }

    // Fix Library. Everyone reads approved fixes. Pending/rejected/retired/trashed: admins see all;
    // others see only their own suggestions. Version history: admins only.
    match /fixCategories/{id} {
      allow read: if member();
    }
    match /fixes/{id} {
      allow read: if member() && (
        resource.data.status == 'approved'
        || admin()
        || resource.data.createdBy == request.auth.token.emp
      );
      match /versions/{v} {
        allow read: if admin();
      }
    }
    match /test_fixes/{id} {
      allow read: if member() && (
        resource.data.status == 'approved'
        || admin()
        || resource.data.createdBy == request.auth.token.emp
      );
      match /versions/{v} {
        allow read: if admin();
      }
    }

    // Trash bin (photos/videos taken off fixes and checklists, kept 30 days) — admins only.
    match /trash/{id} {
      allow read: if admin();
    }
    match /test_trash/{id} {
      allow read: if admin();
    }

    // Open issues (mirrored from Odoo maintenance requests): Maintenance, Admin, Production Manager only (Decision 54).
    // Test-site reports: test_issues.
    // The Open issues board: Maintenance, Admin, Production Manager, and Supervisors (Decision 108 item 6, look only).
    match /issues/{id} {
      allow read: if fixer() || (member() && employee().roles.hasAny(['supervisor']));
    }
    match /test_issues/{id} {
      allow read: if fixer() || (member() && employee().roles.hasAny(['supervisor']));
    }

    // "Need something?" request types (Admin → Request types & routing): everyone signed in reads them.
    match /requestTypes/{id} {
      allow read: if member();
    }

    // Requests: the person who sent it, the people it was sent to, and admins. Test site: test_requests.
    match /requests/{id} {
      allow read: if member() && (resource.data.createdBy == me() || me() in resource.data.recipients || admin()
        || (resource.data.urgent == true && safetyWatcher()));
    }
    match /test_requests/{id} {
      allow read: if member() && (resource.data.createdBy == me() || me() in resource.data.recipients || admin()
        || (resource.data.urgent == true && safetyWatcher()));
    }

    // Announcements: only the people it's meant for (audienceEmps, worked out by the server when posted and
    // when people change), the people tracking it (the poster, and supervisors with crew in it), and Plant
    // Manager / Office / Admin. Test site: test_announcements. Versions (earlier wording) stay server-only.
    function seesAllAnnouncements() {
      return member() && employee().roles.hasAny(['admin', 'plant-manager', 'office']);
    }
    match /announcements/{id} {
      allow read: if member() && (me() in resource.data.audienceEmps || me() in resource.data.trackers || seesAllAnnouncements());
    }
    match /test_announcements/{id} {
      allow read: if member() && (me() in resource.data.audienceEmps || me() in resource.data.trackers || seesAllAnnouncements());
    }
    // "Read & understood" signatures: your own only. Who else signed is shown through the server (tracking).
    match /announcementSigs/{id} {
      allow read: if member() && resource.data.emp == me();
    }
    match /test_announcementSigs/{id} {
      allow read: if member() && resource.data.emp == me();
    }
    // "Opened" records for Important announcements the crew doesn't sign: your own only (written by the server).

    match /announcementOpens/{id} {
      allow read: if member() && resource.data.emp == me();
    }
    match /test_announcementOpens/{id} {
      allow read: if member() && resource.data.emp == me();
    }
    // Announcement tasks (assigned by a Line Lead or Supervisor): the person it's assigned to sees their own; Supervisors,
    // the Production Manager, and Admins see all; a Line Lead sees only their own team's (Chris, 10-23-2026).
    // Written only by the server.
    function annTaskReader() {
      return member() && employee().roles.hasAny(['supervisor', 'plant-manager', 'admin']);
    }
    function annTaskTeamLead() {
      return member() && employee().roles.hasAny(['lead']) && resource.data.team != null && resource.data.team == employee().get('team', null);
    }
    match /annTasks/{id} {
      allow read: if member() && (resource.data.emp == me() || annTaskReader() || annTaskTeamLead());
    }
    match /test_annTasks/{id} {
      allow read: if member() && (resource.data.emp == me() || annTaskReader() || annTaskTeamLead());
    }
    // Every sign-off ever (checklists, announcements, …) — admins only.
    match /signoffs/{id} {
      allow read: if admin();
    }
    match /test_signoffs/{id} {
      allow read: if admin();
    }

    // Forms admins edit (the wording of the paper forms): everyone signed in reads them and their revisions;
    // changes go through the server (Admins, and roles allowed in Admin → Roles).
    match /formTemplates/{id} {
      allow read: if member();
      match /revisions/{rev} {
        allow read: if member();
      }
    }

    // Shift Handoff Notes: Line Leads, Supervisors, Production Manager, Admin (Decision 60). Test site: test_handoffs.
    function handoffReader() {
      return member() && employee().roles.hasAny(['lead', 'supervisor', 'plant-manager', 'admin']);
    }
    match /handoffs/{id} {
      allow read: if handoffReader();
    }
    match /test_handoffs/{id} {
      allow read: if handoffReader();
    }

    // Keep the Shop Clean task lists: Line Leads, Supervisors, Production Manager, Admin, and the people given a task.
    // Test site: test_shopTasks.
    match /shopTasks/{id} {
      allow read: if handoffReader() || (member() && me() in resource.data.assignees);
    }
    match /test_shopTasks/{id} {
      allow read: if handoffReader() || (member() && me() in resource.data.assignees);
    }

    // Station checklists (Reel Building, Reclamation): everyone signed in reads them. Test site: test_stationLists.
    match /stationLists/{id} {
      allow read: if member();
    }
    match /test_stationLists/{id} {
      allow read: if member();
    }

    // Line Check Log (per line) and its plant-wide page 2: everyone signed in reads them. Test site: test_ copies.
    match /lineLogs/{id} {
      allow read: if member();
    }
    match /test_lineLogs/{id} {
      allow read: if member();
    }
    match /plantLogs/{id} {
      allow read: if member();
    }
    match /test_plantLogs/{id} {
      allow read: if member();
    }

    // Reference documents (posted-on-the-floor documents, e.g. the station assignment sheet): signed-in people read.
    match /refDocs/{id} {
      allow read: if member();
    }

    // Machines — parts & specs (Decision 51): Maintenance, Production Manager, Admin, plus any role allowed to edit machines
    // in Admin → Roles (the server keeps that list in meta/machineAccess). Changed only by the server.
    function machineViewer() {
      return fixer() || (member() && exists(/databases/$(database)/documents/meta/machineAccess)
        && employee().roles.hasAny(get(/databases/$(database)/documents/meta/machineAccess).data.roles));
    }
    match /machineSpecs/{id} {
      allow read: if machineViewer();
      match /{sub}/{doc} {
        allow read: if machineViewer();
      }
    }

    // Near-miss & incident reports: Training & Safety, Production Manager, Admin only — the injured person's details too
    // (private/osha). Reporters follow their own report through the server (myIncidents), never by reading here.
    // Corrective actions: the owner sees their own; follow-up sees all. Test site: test_ copies.
    function incidentFollower() {
      return member() && employee().roles.hasAny(['training-safety', 'plant-manager', 'admin']);
    }
    // Injury details (the injury record and signatures, in private/) need HR access; everyone who follows up still sees
    // that a report exists, its status, what happened, root cause, and actions.
    match /incidents/{id} {
      allow read: if incidentFollower();
      match /private/{doc} {
        allow read: if hrAccess();
      }
    }
    match /test_incidents/{id} {
      allow read: if incidentFollower();
      match /private/{doc} {
        allow read: if hrAccess();
      }
    }
    match /incidentActions/{id} {
      allow read: if incidentFollower() || (member() && resource.data.ownerEmp == me());
    }
    match /test_incidentActions/{id} {
      allow read: if incidentFollower() || (member() && resource.data.ownerEmp == me());
    }
    // Shift rotation (which team works which days): everyone signed in reads.
    match /meta/rotation {
      allow read: if member();
    }

    // Who to Call: the call sheet (numbers, extensions, on-call contacts who agreed) and call-button taps (for the
    // line-down reminder). Everyone signed in reads; only the server writes.
    match /meta/callSheet {
      allow read: if member();
    }
    match /callTaps/{id} {
      allow read: if member();
    }
    match /test_callTaps/{id} {
      allow read: if member();
    }

    // Flagged reels / QC hold and its lists (reasons, sizes, SDRs): everyone signed in reads — the floor works the list.
    match /reels/{id} {
      allow read: if member();
    }
    match /test_reels/{id} {
      allow read: if member();
    }
    match /meta/reelSettings {
      allow read: if member();
    }

    // Silo levels (from the Shift Handoff and "Update silo levels") and their low lines: everyone signed in reads.
    match /siloLevels/{id} {
      allow read: if member();
    }
    match /test_siloLevels/{id} {
      allow read: if member();
    }
    match /meta/siloSettings {
      allow read: if member();
    }

    // Trucks board: Logistics & Distribution, Production Manager, Sales, Admin, plus roles allowed to post trucks in
    // Admin → Roles (the server keeps that list in meta/truckAccess). Changed only by the server. Test site: test_trucks.
    function truckViewer() {
      return member() && (employee().roles.hasAny(['shipping', 'plant-manager', 'sales', 'admin'])
        || (exists(/databases/$(database)/documents/meta/truckAccess)
          && employee().roles.hasAny(get(/databases/$(database)/documents/meta/truckAccess).data.roles)));
    }
    match /trucks/{id} {
      allow read: if truckViewer();
    }
    match /test_trucks/{id} {
      allow read: if truckViewer();
    }

    // Admin-only lists: who did what (every admin action), Odoo sync status, searches with no results.
    match /auditLog/{id} {
      allow read: if admin();
    }
    // Plant status bar on Home: which lines are down (a summary; no issue details).
    match /meta/plantStatus {
      allow read: if member();
    }
    match /test_meta/plantStatus {
      allow read: if member();
    }
    match /meta/odooSync {
      allow read: if admin();
    }
    match /searchGaps/{id} {
      allow read: if admin();
    }

    // Everything else — employees, PIN records, counters — stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
