rules_version = '2';

// Firestore (database) security rules for cdg-ops-app.
// Default: everything is locked. Each feature opens only the access it needs.
// Server code (Cloud Functions) is not limited by these rules — all changes go through it.
service cloud.firestore {
  match /databases/{database}/documents {

    // Signed in with employee # + PIN, and already picked their own PIN (not on a temporary one).
    function signedIn() {
      return request.auth != null && request.auth.token.pinTemp != true;
    }

    // Admins approve fixes and see admin-only lists (Plan Decision 27, updated: admins only).
    function approver() {
      return signedIn() && request.auth.token.roles.hasAny(['admin']);
    }

    // Lines, machines, roles: everyone signed in can read (shop map, checklists, Fix Library need them).
    // Only the server changes them (admin screens call adminSaveLine / adminSaveMachine / adminSaveRole).
    match /lines/{id} {
      allow read: if signedIn();
    }
    match /machines/{id} {
      allow read: if signedIn();
    }
    match /roles/{id} {
      allow read: if signedIn();
    }

    // Fix Library. Everyone signed in reads approved fixes and categories. Pending/rejected/retired
    // fixes: approvers see all; others see only their own suggestions. Changes: server only (submitFix, …).
    match /fixCategories/{id} {
      allow read: if signedIn();
    }
    match /fixes/{id} {
      allow read: if signedIn() && (
        resource.data.status == 'approved'
        || approver()
        || resource.data.createdBy == request.auth.token.emp
      );
    }

    // Open issues (mirrored from Odoo maintenance requests): everyone signed in can read.
    // Changes come only from the server (reportProblem, markIssueFixed, the 5-minute Odoo sync).
    match /issues/{id} {
      allow read: if signedIn();
    }

    // Odoo sync status — admins only.
    match /meta/odooSync {
      allow read: if approver();
    }

    // Searches that found no fixes — admins only (tells you what fixes to write next).
    match /searchGaps/{id} {
      allow read: if approver();
    }

    // Everything else — employees, PIN records, audit log, counters — stays locked.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
