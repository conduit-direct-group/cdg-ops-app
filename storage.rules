rules_version = '2';

// Storage (photos/videos/documents) security rules for cdg-ops-app.
// Default: everything is locked. Each feature opens only the access it needs.
service firebase.storage {
  match /b/{bucket}/o {

    // Signed in with employee # + PIN, and already picked their own PIN.
    function signedIn() {
      return request.auth != null && request.auth.token.get('pinTemp', false) != true;
    }

    // Fix Library files copied from the old library (written by the server only).
    match /fixes/{allPaths=**} {
      allow read: if signedIn();
    }

    // Photos, videos, and PDFs people attach to fixes. Each person uploads only into their own folder.
    // 250 MB max per file (phone videos are big).
    match /uploads/{employeeNumber}/{fileName} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.auth.token.emp == employeeNumber
        && request.resource.size < 250 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|application/pdf');
    }

    // Safety reports (near misses, injuries, first aid): the PRIVATE folder (checked against the live employee record). Only the server
    // writes here, except the phone's photo upload into safety/incoming/ — a random file name (no employee number, so
    // anonymous near misses stay anonymous), JPEG, under 5 MB. Nobody else can read incoming photos.
    function safetyFollower() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/employees/$(request.auth.token.emp)).data.roles.hasAny(['training-safety', 'plant-manager', 'admin'])
        && firestore.get(/databases/(default)/documents/employees/$(request.auth.token.emp)).data.active != false;
    }
    match /safety/incoming/{fileName} {
      allow create: if signedIn()
        && fileName.matches('^[A-Za-z0-9]{20,40}[.]jpg$')
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType == 'image/jpeg';
    }
    // HR access (a per-person switch): injury / first-aid photos and every drawn signature. Near-miss, property, and
    // spill photos stay readable by the people who follow up.
    function hrAccess() {
      return signedIn()
        && firestore.get(/databases/(default)/documents/employees/$(request.auth.token.emp)).data.get('hrAccess', false) == true
        && firestore.get(/databases/(default)/documents/employees/$(request.auth.token.emp)).data.active != false;
    }
    function followUpPhoto(collectionName, incidentId, fileName) {
      return safetyFollower()
        && fileName.matches('^photo-[0-9]+[.]jpg$')
        && !(firestore.get(/databases/(default)/documents/$(collectionName)/$(incidentId)).data.type in ['injury', 'first-aid']);
    }
    match /safety/test/{incidentId}/{fileName} {
      allow read: if hrAccess() || followUpPhoto('test_incidents', incidentId, fileName);
    }
    match /safety/{incidentId}/{fileName} {
      allow read: if incidentId != 'incoming' && incidentId != 'test' && (hrAccess() || followUpPhoto('incidents', incidentId, fileName));
    }

    // Everything else stays locked.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
